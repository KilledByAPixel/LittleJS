{
    "plugins": ["plugins/markdown"],
    "recurseDepth": 10,
    "source": {
        "include": ["src", "plugins", "README.md"],
        "exclude": ["src/engineBuild.mjs"]
    },
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc","closure"]
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "littlejs": {
            "title": "LittleJS Documentation",
            "repo": "https://github.com/KilledByAPixel/LittleJS",
            "footer": "<a href=\"https://github.com/KilledByAPixel/LittleJS\">LittleJS - MIT License - Copyright 2021 Frank Force</a>",
            "menu": [
                { "title": "GitHub", "link": "https://github.com/KilledByAPixel/LittleJS" },
                { "title": "Examples", "link": "https://killedbyapixel.github.io/LittleJS/examples/" },
                { "title": "Reference", "link": "https://github.com/KilledByAPixel/LittleJS/blob/main/REFERENCE.md" },
                { "title": "FAQ", "link": "https://github.com/KilledByAPixel/LittleJS/blob/main/FAQ.md" }
            ],
            "meta": [
                { "name": "description", "content": "LittleJS is a lightweight HTML5 game engine with fast WebGL rendering, physics, particles, sound, and more!" },
                { "name": "keywords", "content": "javascript, game engine, html5, webgl, 2d, game development, indie games" },
                { "name": "author", "content": "Frank Force" },
                { "property": "og:title", "content": "LittleJS - The Tiny JavaScript Game Engine" },
                { "property": "og:description", "content": "Lightweight HTML5 game engine with WebGL rendering, physics, and sound" },
                { "property": "og:type", "content": "website" }
            ]
        }
    },
    "opts": {
        "encoding": "utf8",
        "readme": "./README.md",
        "destination": "./docs/",
        "recurse": true,
        "verbose": true,
        "template": "./tools/docs"
    },
    "markdown": {
        "hardwrap": false,
        "idInHeadings": true
    }
}
